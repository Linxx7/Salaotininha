# ─────────────────────────────────────────────
# Salão Tininha — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no git.
# ─────────────────────────────────────────────

# ── Site ──────────────────────────────────────
# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://salaotininha.com.br

# ── Cal.com ───────────────────────────────────
# Username do Cal.com para o widget de agendamento
# Obtenha em: https://cal.com → Settings → Profile
NEXT_PUBLIC_CAL_USERNAME=

# ── Sanity.io (CMS) ───────────────────────────
# Sem essas variáveis, o site usa dados estáticos de /lib/data/ (funciona normalmente)
# Project ID: https://sanity.io/manage → seu projeto
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token de leitura (server-side only — NÃO adicionar prefixo NEXT_PUBLIC_)
# Obtenha em: https://sanity.io/manage → API → Tokens
SANITY_API_READ_TOKEN=

# ── Google Analytics ──────────────────────────
# Formato: G-XXXXXXXXXX
# Obtenha em: https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_ID=

# ── Resend (formulário de contato) ────────────
# API Key: https://resend.com/api-keys
RESEND_API_KEY=
# Email que receberá as mensagens do formulário de contato
CONTACT_EMAIL=seu@email.com
# Remetente do email — IMPORTANTE para produção:
# - Sem esta variável: usa onboarding@resend.dev (só envia para o email da conta Resend)
# - Para funcionar para qualquer email: verifique um domínio em https://resend.com/domains
#   e configure: RESEND_FROM_EMAIL=Salão Tininha <contato@salaotininha.com.br>
RESEND_FROM_EMAIL=
